# Copy to .env and fill in. .env is gitignored — never commit it.

NODE_ENV=development
PORT=3000

# Database
DB_PATH=./database/campus_events.db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_events
DB_USER=campus_app
DB_PASS=change_me_before_running
# Auth — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32_output
# API
CORS_ORIGIN=http://localhost:3000
API_VERSION=v1
MAX_EVENTS_PER_PAGE=20
MAX_STUDENTS_PER_EVENT=500
# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_address@gmail.com
EMAIL_PASS=abcdefghijklmnop