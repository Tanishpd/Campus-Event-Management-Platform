# Copy to .env and fill in. .env is gitignored — never commit it.

NODE_ENV=development
PORT=3000

# Database
DB_PATH=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=

# API
CORS_ORIGIN=
API_VERSION=
MAX_EVENTS_PER_PAGE=
MAX_STUDENTS_PER_EVENT=

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
